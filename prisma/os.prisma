// DM OS models (our fork only). Upstream lives in schema.prisma; nothing here
// adds a relation field to an upstream model, so pulls from upstream never
// conflict with this file. The cost: workspace/account ids below are plain
// columns without foreign keys, and cleanup on delete is done in app code.

enum ContactKind {
  SALES
  PERSONAL
  UNSORTED
  /// People selling to Kevin and other creators' automations. J never drafts here.
  PITCHES
}

/// Kanban columns. J's six setting stages are a separate field, not columns.
enum ContactStage {
  NEW
  LEAD_MAGNET_SENT
  IN_CONVERSATION
  QUALIFIED
  NOT_QUALIFIED
  CALL_OFFERED
  CALL_BOOKED
  SHOWED
  WON
  LOST
}

/// One person on one Instagram account. igUserId is the Instagram-scoped id
/// Zernio gives us; it is the same on comments (DmLog.commenterId) and DMs
/// (EmailCapture.userId), so both join here on (instagramAccountId, igUserId).
model Contact {
  id                 String       @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  igUserId           String

  username             String?
  fullName             String?
  avatarUrl            String?
  zernioConversationId String?
  email                String?

  kind ContactKind @default(UNSORTED)
  /// Who set kind: "entry" (came in through a campaign), "triage" (J's guess,
  /// not confirmed yet) or "user".
  kindSource String?
  /// J's suggestion for kind (lib/os/setter/triage.ts). On an Unsorted contact
  /// it is the triage guess; on a Personal one, SALES means "move to Sales?"
  /// (they asked about the offer). Cleared once the user decides.
  suggestedKind   ContactKind?
  /// One line on why, shown next to the suggestion.
  suggestedReason String?
  /// Jev's probability for the suggestion (0-1); null from the LLM backend.
  /// Set while suggestedKind is null: J looked but isn't sure.
  suggestedConfidence Float?
  /// Which triage backend made the current judgment: fake | llm | jev. A
  /// manual "Sort with J" re-judges anything from a weaker backend (fake
  /// always), even on a message J already looked at.
  suggestedBy         String?
  /// When J last looked, and at which of their messages (re-check only when
  /// they write something new).
  triagedAt        DateTime?
  triagedMessageId String?
  stage      ContactStage @default(NEW)
  /// J's setting stage (opener, value, permission, qualify, bridge, booked).
  setterStage String?
  /// How they first reached us, e.g. "comment", "keyword_dm", "story_reply".
  entryPath String?
  tags      String[]
  /// J never drafts or nudges while true.
  paused    Boolean  @default(false)
  /// On the Follow-up Friday list (the Follow-ups screen). Stays on after a
  /// send; the next Friday offers them the next resource they haven't had.
  onFriday      Boolean   @default(false)
  fridayAddedAt DateTime?
  notes     String?
  /// One-time imports that touched this contact (scripts/os-import-*.ts):
  /// {leadflow?: {at, personId, stage, kind}, setter?: {at}}. A re-import only
  /// changes stage/kind while they still equal what the last import wrote.
  imported  Json?

  lastMessageAt DateTime?
  // --- CRM (dm-crm part A). Read only by what Kevin sees (inbox, Home tile);
  // the setter record stays the one source for every send decision.
  /// Their last inbound DM (Zernio message-received webhook).
  lastInboundAt      DateTime?
  /// Our last successful send of any kind (stampSend, lib/os/send-stamp.ts).
  lastOutboundAt     DateTime?
  /// When Kevin last opened the thread here (or sent from it). Unread =
  /// lastInboundAt later than this, or never opened.
  lastOpenedAt       DateTime?
  /// Kevin's own send, or a J draft Kevin approved (never automated sends).
  /// A contact with one is never flagged as spam.
  lastPersonalSendAt DateTime?
  starred            Boolean   @default(false)
  /// Set by the spam heuristic on inbound text (lib/os/spam).
  spam               Boolean   @default(false)
  /// Kevin's sticky override: true = spam, false = not spam, null = none.
  /// The heuristic never changes a contact with an override.
  spamOverride       Boolean?
  /// Hidden from Contacts, Pipeline and Inbox while set; a new inbound clears it.
  archivedAt         DateTime?
  /// When they last read our messages (message.read webhook, or readAt on the
  /// newest outgoing Zernio message). Drives "Seen" in the thread.
  seenAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  setterState SetterState?
  drafts      Draft[]
  /// The knowledge base that answers this person. Null = the default setter
  /// for the IG account; set when a campaign override picked one (spec 13).
  setterId    String?
  setter      Setter?      @relation(fields: [setterId], references: [id], onDelete: SetNull)
  /// One row per connected CRM / email list (lib/os/integrations).
  syncs       ContactSync[]
  fridaySends FridaySend[]
  /// Calls J booked in the DM (lib/os/integrations/calendar).
  bookings    Booking[]
  /// Per-thread "Follow-ups off": no sequence step is queued for them.
  followupsOff  Boolean        @default(false)
  followupSteps FollowupStep[]
  tasks         OsTask[]
  stageLog      ContactStageLog[]

  @@unique([workspaceId, instagramAccountId, igUserId])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, kind])
  @@index([workspaceId, stage])
  @@index([workspaceId, onFriday])
  @@index([zernioConversationId])
}

/// J's state machine record for one contact (lib/os/setter/state.ts). The
/// record keeps the Python contacts.json shape so step 8 can import it as-is;
/// state and the next timer are copied out for queries.
model SetterState {
  id             String    @id @default(cuid())
  contactId      String    @unique
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspaceId    String
  state          String
  record         Json
  nextActionKind String?
  nextActionAt   DateTime?
  /// Snoozed on the Follow-ups screen: the nudge stays out of the queue until then.
  snoozedUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, state])
  @@index([nextActionAt])
}

enum DraftStatus {
  PENDING
  /// Claimed for sending; becomes SENT, or back to PENDING if the send fails.
  APPROVED
  SENT
  DISCARDED
}

/// One draft J wrote, waiting for approval in the Inbox. Approve-only: nothing
/// sends a draft without a person pressing Approve (spec item 9).
model Draft {
  id           String      @id @default(cuid())
  workspaceId  String
  contactId    String
  contact      Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// reply | value_opener | nudge | invite
  kind         String
  /// The message (or timer) this draft answers; one live draft per anchor.
  anchor       String
  bubbles      String[]
  status       DraftStatus @default(PENDING)
  reasoning    String?
  setterStage  String?
  /// Must go out under Meta's HUMAN_AGENT tag (they last wrote over 24h ago).
  humanAgent   Boolean     @default(false)
  /// Why this needs a careful look: human_agent, invite, price, unqualified.
  flags        String[]
  proposedTags Json?
  raw          Json?
  backend      String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  /// What was actually sent when the user edited the draft first. Feeds the
  /// voice-corrections loop.
  editedText   String?
  edited       Boolean     @default(false)
  /// Which knowledge base wrote it (null = the file fallback).
  setterId     String?
  sendError    String?
  /// kind "booking": what Approve books before it sends (BookingPayload in
  /// lib/os/integrations/calendar/types.ts): provider, event type, slot start,
  /// timezone, name, email.
  booking      Json?
  /// A/B lines this draft carries: AbTag[] (lib/os/experiments/types.ts),
  /// {experimentId, variantId, slot}. Approve attributes the send to them.
  abVariants   Json?
  /// Hold (H in the composer): kept PENDING but out of the review queue
  /// until they write again or Kevin un-holds it.
  heldAt       DateTime?
  heldReason   String?
  createdAt    DateTime    @default(now())
  decidedAt    DateTime?
  sentAt       DateTime?

  @@index([workspaceId, status])
  @@index([contactId, status])
}

// --- Knowledge bases (build step 4) ------------------------------------------
// The Setting Script (method) ships with the code and is the same for every
// setter. A Setter row holds only the per-setter parts (spec items 11-15).

enum SetterAutonomy {
  APPROVE
  /// Reserved: no code path sends without approval (spec item 9).
  AUTO
}

/// One knowledge base: what one setter knows. JSON shapes are in
/// lib/os/setter/profile.ts (SetterProfile).
model Setter {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  autonomy    SetterAutonomy @default(APPROVE)
  /// The IG account this setter answers for when isDefault is true; null with
  /// isDefault = the workspace default. App code keeps one default per account.
  instagramAccountId String?
  isDefault          Boolean @default(false)

  /// ig_username, operator, audience, allowed_emojis, cal_com_url, tag_options…
  settings         Json   @default("{}")
  /// The business facts J may state: {sections: {offer, icp, …}, objections: []}.
  business         Json   @default("{}")
  /// Offer[]: name, status, sold_by, price, pitch, fit_criteria…
  offers           Json   @default("[]")
  /// FunnelStage[]: the client journey, one entry per stage.
  funnel           Json   @default("[]")
  voice            String @default("")
  voiceExamples    String @default("")
  /// Full example threads (markdown).
  examples         String @default("")
  /// VoiceCorrection[]: {title, body}, oldest first.
  voiceCorrections Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resources  SetterResource[]
  campaigns  CampaignSetter[]
  contacts   Contact[]
  voiceClips VoiceClip[]
  sequences  FollowupSequence[]

  @@index([workspaceId])
  @@index([workspaceId, instagramAccountId])
}

enum ResourceStatus {
  ACTIVE
  TEST
  DRAFT
}

/// One row of the workspace catalog (was scripts/dms/resources.json). kind
/// "resource" is a lead magnet J may offer; kind "setter" is an entry path
/// (a keyword that opens a setter conversation), never offered.
model Resource {
  id          String         @id @default(cuid())
  workspaceId String
  slug        String
  kind        String         @default("resource")
  name        String
  link        String?
  keyword     String?
  status      ResourceStatus @default(DRAFT)
  /// What J should know about it (for_setter).
  description String         @default("")
  /// The rest of the catalog row (triggers, zernio/dm copy, opener, match,
  /// next_step…) so J's matching keeps working exactly as with the file.
  data        Json           @default("{}")
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  setters SetterResource[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

/// Which lead magnets a setter may offer (the toggle list in its knowledge base).
model SetterResource {
  setterId   String
  setter     Setter   @relation(fields: [setterId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([setterId, resourceId])
  @@index([resourceId])
}

/// Campaign override: contacts who came in through this OpenReply automation
/// are answered by this setter. automationId is a plain column (no relation
/// to the upstream Automation model).
model CampaignSetter {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String   @unique
  setterId     String
  setter       Setter   @relation(fields: [setterId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([setterId])
}

// --- Integrations (build step 7) ---------------------------------------------
// One-way push to the workspace's CRM / email list on events (spec 20-21).
// Kit's key stays in the upstream CrmConnection (the email gate reads it);
// providers the upstream CrmProvider enum doesn't know (GoHighLevel) keep their
// credentials here. Every provider keeps its field mapping here.

/// One provider's settings for a workspace. provider: "kit" | "ghl" |
/// "calcom" | "calendly". Calendar tokens are encrypted in credentials too.
model OsIntegration {
  id           String    @id @default(cuid())
  workspaceId  String
  provider     String
  /// Encrypted (ENCRYPTION_KEY, like Instagram tokens) JSON of the secrets,
  /// e.g. {"token": "..."} for GoHighLevel. Null for Kit (CrmConnection has it).
  credentials  String?
  /// GoHighLevel location (sub-account) id. Not secret.
  locationId   String?
  /// FieldMapping (lib/os/integrations/mapping.ts).
  mapping      Json      @default("{}")
  /// Paused: events are not pushed to this provider. For a calendar
  /// (calcom, calendly): J books on it.
  enabled      Boolean   @default(true)
  /// Calendar providers only: CalendarSettings (lib/os/integrations/calendar/settings.ts),
  /// e.g. the event type per setter, working hours, how many times to offer.
  settings     Json      @default("{}")
  lastTestedAt DateTime?
  lastError    String?
  /// Calendar providers: the encrypted secret their webhooks are signed with
  /// (app/api/os/calendar). Null until webhooks are set up.
  webhookSecret String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, provider])
}

/// Per-contact sync log for one provider: what we last pushed and how it went.
model ContactSync {
  id           String    @id @default(cuid())
  workspaceId  String
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider     String
  /// The provider's id for the person (GHL contact id, Kit subscriber id).
  externalId   String?
  /// Hash of the last payload pushed successfully: an unchanged contact is
  /// not pushed again (idempotent retries and duplicate events).
  lastHash     String?
  /// Tags as last pushed, so a tag removed here is removed there too.
  pushedTags   String[]
  lastEvent    String?
  lastSyncedAt DateTime?
  lastError    String?
  lastErrorAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([contactId, provider])
  @@index([workspaceId, provider])
}

// --- Follow-ups (Friday sends) -------------------------------------------------

/// One resource sent to one person from the Follow-up Friday list. The unique
/// (contactId, resourceSlug) is the send claim: a resource never goes to the
/// same person twice, even with two tabs racing. A send that fails before any
/// bubble went out deletes its row so it can be retried.
model FridaySend {
  id           String    @id @default(cuid())
  workspaceId  String
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  resourceId   String?
  resourceSlug String
  /// The Friday this send belongs to, "YYYY-MM-DD" in the workspace timezone.
  friday       String
  bubbles      String[]
  humanAgent   Boolean   @default(false)
  /// sending | sent | partial
  status       String    @default("sending")
  error        String?
  createdAt    DateTime  @default(now())
  sentAt       DateTime?

  @@unique([contactId, resourceSlug])
  @@index([workspaceId, friday])
}

// --- Calendar booking --------------------------------------------------------
// J books calls inside the DM: it offers real times, takes their email and,
// once Kevin approves, books through Cal.com or Calendly (spec item 9: only
// an Approve books).

enum BookingStatus {
  /// The provider has the booking; waiting for their screenshot.
  BOOKED
  /// They sent the screenshot of the calendar invite (Kevin's commitment step).
  CONFIRMED
  /// Calendly without direct booking: we sent a link for that exact time.
  LINK_SENT
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  workspaceId String
  contactId   String
  contact     Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// The approved draft that booked it: one booking per draft, so a retried
  /// approve (bubbles failed to send) never books twice.
  draftId     String?       @unique
  /// "calcom" | "calendly" | "mock"
  provider    String
  eventTypeId String
  eventName   String?
  /// The provider's id: Cal.com booking uid, Calendly invitee uri.
  externalId  String?
  start       DateTime
  end         DateTime?
  /// The lead's IANA timezone (what J quoted the time in).
  timezone    String
  name        String?
  email       String
  status      BookingStatus @default(BOOKED)
  /// Calendly link fallback, or the provider's manage link.
  url         String?
  confirmedAt DateTime?
  /// Did they come? From the calendar's webhook or Kevin marking it.
  attendance       Attendance?
  /// "user" | "calcom" | "calendly"
  attendanceSource String?
  attendanceAt     DateTime?
  cancelledAt      DateTime?
  rescheduledAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId, start])
  @@index([workspaceId, externalId])
  @@index([contactId])
}

enum Attendance {
  SHOWED
  NO_SHOW
}

// --- Follow-up sequences (wave 2, item 3) ------------------------------------
// lib/os/sequences: per-setter sequences (no reply per stage, before the call,
// no-show) and the queue of steps. One live step per contact at a time.

/// One sequence of one setter. No row = the default (lib/os/sequences/types.ts).
model FollowupSequence {
  id          String   @id @default(cuid())
  workspaceId String
  setterId    String
  setter      Setter   @relation(fields: [setterId], references: [id], onDelete: Cascade)
  /// no_reply_lead | no_reply_qualifying | no_reply_value | no_reply_invite | pre_call | no_show | showed
  key         String
  enabled     Boolean  @default(true)
  /// SequenceStep[]: id, label, timing, intent, fixedLine, voicePhrase, resource.
  steps       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([setterId, key])
  @@index([workspaceId])
}

enum FollowupStepStatus {
  /// Waiting for its time (a delayed job on os-setter).
  QUEUED
  /// J wrote it: a Draft (kind "followup") waits for approval.
  DRAFTED
  SENT
  /// Skipped by Kevin, held by J, or nothing to send (window closed, no resource left).
  SKIPPED
  /// The plan moved on (they replied, the call moved), or Kevin cancelled the sequence (reason "stopped").
  CANCELLED
}

/// One step of a sequence for one contact: the queue and its history.
model FollowupStep {
  id            String             @id @default(cuid())
  workspaceId   String
  contactId     String
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  setterId      String?
  sequence      String
  stepId        String
  stepIndex     Int
  /// One run of a sequence: a silence, a booking, a no-show.
  episode       String
  /// sequence + episode + step: the same step is never queued twice.
  key           String             @unique
  dueAt         DateTime
  status        FollowupStepStatus @default(QUEUED)
  /// = contactId while QUEUED or DRAFTED, else null. The unique index is the
  /// "never two follow-ups queued for one contact" guarantee.
  liveContactId String?            @unique
  /// The step as configured when it was queued (label, intent, fixed line, voice phrase).
  step          Json
  draftId       String?
  bookingId     String?
  /// Why it was skipped or cancelled.
  reason        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  doneAt        DateTime?

  @@index([workspaceId, status, dueAt])
  @@index([contactId, sequence])
}

enum OsTaskStatus {
  OPEN
  DONE
  DISMISSED
}

/// Something for Kevin to do by hand, e.g. "Send a personal voice note to @x"
/// after they showed up to the call. Never automated.
model OsTask {
  id          String       @id @default(cuid())
  workspaceId String
  contactId   String
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// voice_note
  kind        String
  title       String
  /// {goal, pain, notes, lastWords[]}: what to talk about, from the thread.
  context     Json         @default("{}")
  status      OsTaskStatus @default(OPEN)
  /// kind + booking: one task per call, however often it is marked.
  dedupeKey   String       @unique
  bookingId   String?
  createdAt   DateTime     @default(now())
  doneAt      DateTime?

  @@index([workspaceId, status])
  @@index([contactId])
}

// --- A/B tests (wave 2, item 2) ------------------------------------------------
// Variants for openers and key lines. A slot names where the text goes:
// campaign_opener:<automationId> (OpenReply's opening DM), j_opener:<entry>
// (J's first message, entry = how they arrived or "any") and line:<key>
// (permission_ask, value_offer, invite, follow_up_1). Funnel numbers are not
// stored: lib/os/experiments/funnel.ts counts them from existing data.

enum ExperimentStatus {
  /// Written, never started: no one is assigned (line tests, migrated Funnel variations).
  DRAFT
  RUNNING
  PAUSED
  FINISHED
}

enum ExperimentAllocation {
  EVEN
  WEIGHTED
}

model Experiment {
  id          String               @id @default(cuid())
  workspaceId String
  /// Only this setter's drafts use it; null = every setter. Ignored for campaign openers.
  setterId    String?
  name        String
  slot        String
  status      ExperimentStatus     @default(RUNNING)
  allocation  ExperimentAllocation @default(EVEN)
  /// Sends per variant before the table stops saying "too early".
  minSends    Int                  @default(50)
  /// Picked winner: the only active variant once finished.
  winnerVariantId String?
  notes       String?
  startedAt   DateTime             @default(now())
  finishedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  variants    Variant[]
  assignments Assignment[]

  @@index([workspaceId, slot, status])
}

model Variant {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  /// "A", "B"… shown in the table.
  label        String
  text         String
  /// Used when the experiment's allocation is WEIGHTED.
  weight       Int        @default(1)
  /// Inactive variants get no new contacts; existing ones keep theirs.
  active       Boolean    @default(true)
  /// pattern_interrupt | specific_question | references_action | custom…
  style        String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  assignments Assignment[]

  @@index([experimentId])
}

/// One person in one experiment. A contact keeps its variant: the unique key is
/// the person (IG account + Instagram-scoped id), so it holds before a Contact
/// row exists (campaign openers go out at comment time).
model Assignment {
  id                 String     @id @default(cuid())
  workspaceId        String
  experimentId       String
  experiment         Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variantId          String
  variant            Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  instagramAccountId String
  igUserId           String
  contactId          String?
  assignedAt         DateTime   @default(now())
  /// When the line first went out (J's approved draft). Campaign openers leave
  /// it null; their send is read from DmLog.
  sentAt             DateTime?
  draftId            String?
  /// Kevin rewrote the line heavily before sending. Still attributed.
  edited             Boolean    @default(false)
  sentText           String?

  @@unique([experimentId, instagramAccountId, igUserId])
  @@index([workspaceId])
  @@index([variantId])
  @@index([contactId])
}

// --- Voice notes (wave 2, item 1) --------------------------------------------
// Kevin's real recordings. Bank clips are phrase-matched: when a message J
// sends contains a clip's line and that person hasn't heard it, the clip goes
// instead of the text (once per person). Manual clips and one-off recordings
// are sent by hand from the Inbox composer.

/// The audio bytes of one recording. Railway has no persistent disk and
/// Zernio's uploads expire after 7 days, so clips live here (they are tiny)
/// and are served from /api/os/voice/<id>.<ext>: id is 32 random url-safe
/// characters (192 bits), the only way to reach a file. There is no listing.
model VoiceAudio {
  id          String   @id
  workspaceId String
  /// audio/mp4 (m4a), audio/wav or audio/aac: formats Instagram accepts.
  mimeType    String
  /// m4a | wav | aac (the extension in the public url).
  ext         String
  bytes       Bytes
  sizeBytes   Int
  durationMs  Int?
  createdAt   DateTime @default(now())

  clips VoiceClip[]

  @@index([workspaceId])
}

enum VoiceClipKind {
  /// Sent automatically in place of matching text (first time per person).
  BANK
  /// Only sent by hand from the composer.
  MANUAL
}

model VoiceClip {
  id          String        @id @default(cuid())
  workspaceId String
  setterId    String
  setter      Setter        @relation(fields: [setterId], references: [id], onDelete: Cascade)
  /// The suggested slot it was pre-filled from (v01-v15), if any.
  slot        String?
  label       String        @default("")
  /// The exact line spoken. Bank matching is a normalised contains-match on it.
  phrase      String        @default("")
  /// Setter stage it belongs to (Open, Value, Qualify…), free text.
  stage       String?
  kind        VoiceClipKind @default(BANK)
  /// A lead-in ("just headed to the gym, quick one.."): it matches only at the
  /// start of a bubble and the rest of the bubble follows as text.
  leadIn      Boolean       @default(false)
  active      Boolean       @default(false)
  audioId     String?
  audio       VoiceAudio?   @relation(fields: [audioId], references: [id], onDelete: SetNull)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([setterId, sortOrder])
  @@index([workspaceId])
}

/// One voice note that went to one person. contactId/clipId/audioId are plain
/// columns (sample-data contacts are not rows). bankKey ("<contact>:<clip>")
/// is set only for bank sends: its unique index is the once-per-person claim,
/// so two approvals racing can't both play the same line. A send that fails
/// deletes its row.
model VoiceSend {
  id             String    @id @default(cuid())
  workspaceId    String
  contactId      String
  conversationId String?
  clipId         String?
  audioId        String
  /// bank | manual | oneoff
  kind           String
  /// What was said: the clip's line, or Kevin's note for a one-off.
  transcript     String    @default("")
  bankKey        String?   @unique
  draftId        String?
  /// Instagram's message id (mid), to show the player in the thread.
  messageId      String?
  /// sending | sent
  status         String    @default("sending")
  sentAt         DateTime  @default(now())

  @@index([contactId])
  @@index([workspaceId, conversationId])
  @@index([messageId])
}

// --- UI redesign (wave 0, 2026-10-20) ------------------------------------------
// docs/sp/dms/2026-10-19-dm-os-ui-plan.md section 2. No relations to upstream
// models; ids of upstream rows (workspace, automation) are plain columns.

/// Workspace-level switches: the daily send cap and the kill switch.
/// One row per workspace, created on first read (lib/os/workspace-settings.ts).
model OsWorkspace {
  workspaceId   String   @id
  /// Every outgoing bubble counts (lib/os/sending/cap.ts).
  sendCapPerDay Int      @default(80)
  /// Pause all: no send and no draft job runs while true.
  pausedAll     Boolean  @default(false)
  /// IANA zone the "today" of the cap and the Friday window are read in.
  timezone      String   @default("Europe/Luxembourg")
  /// ISO 4217 code offer prices and won amounts are read in. No conversion.
  currency      String   @default("EUR")
  updatedAt     DateTime @updatedAt
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  DATE
  TIMEZONE
  SELECT
  URL
}

/// A global contact field (Settings › Custom fields). Setters only tick which
/// fields J fills (SetterField). first_name and email are built in.
model CustomField {
  id          String          @id @default(cuid())
  workspaceId String
  /// snake_case, stable: J's output JSON and the CRM mapping use it.
  key         String
  label       String
  type        CustomFieldType @default(TEXT)
  builtIn     Boolean         @default(false)
  /// SELECT choices: string[].
  options     Json            @default("[]")
  /// GoHighLevel custom field id / "contact.x" key, and Kit field key. Null = not sent.
  ghlField    String?
  kitField    String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  setters SetterField[]
  values  ContactFieldValue[]

  @@unique([workspaceId, key])
  @@index([workspaceId, sortOrder])
}

/// Which fields a setter fills from the chat.
model SetterField {
  setterId String
  fieldId  String
  field    CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([setterId, fieldId])
  @@index([fieldId])
}

/// One field value on one contact. source: j | user | import. J never
/// overwrites a user value (lib/os/fields/capture.ts).
model ContactFieldValue {
  contactId String
  fieldId   String
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String
  source    String      @default("j")
  /// The draft J filled it from.
  draftId   String?
  updatedAt DateTime    @updatedAt

  @@id([contactId, fieldId])
  @@index([fieldId])
}

/// Keyword → resource: the lead magnet an OpenReply automation hands out.
/// Without a row the resource is resolved from the automation's link.
model CampaignResource {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String   @unique
  resourceId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([resourceId])
}

/// Media in a DM, enriched at arrival (CDN urls expire): voice transcript,
/// image description, shared post caption, story card. Fed to J as text.
model MessageMedia {
  id             String   @id @default(cuid())
  workspaceId    String
  contactId      String?
  conversationId String
  /// Instagram message id (mid).
  messageId      String   @unique
  /// incoming | outgoing
  direction      String
  /// voice | image | video | share | story_reply | link | file
  kind           String
  sourceUrl      String?
  /// pending | done | failed | skipped | expired
  status         String   @default("pending")
  transcript     String?
  description    String?
  caption        String?
  /// Story card from Data OS: {id, thumbnailUrl, caption, topic, postedAt, permalink}.
  story          Json?
  provider       String?
  error          String?
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId, conversationId])
}

/// Outcome log behind Home's numbers. kind: keyword_trigger | conversation_started |
/// lead_magnet_sent | offer_made | call_booked | showed | won | dm_sent.
/// dedupeKey makes every recorder idempotent (lib/os/events.ts).
model OsEvent {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String?
  setterId    String?
  kind        String
  at          DateTime @default(now())
  dedupeKey   String   @unique
  data        Json     @default("{}")

  @@index([workspaceId, kind, at])
  @@index([contactId])
}

/// A setter's knowledge as Markdown docs. key: system_prompt | business |
/// offers | objections | examples. The profile is built from these when present.
model SetterDoc {
  id        String   @id @default(cuid())
  setterId  String
  key       String
  body      String   @default("")
  updatedAt DateTime @updatedAt
  updatedBy String?

  revisions SetterDocRevision[]

  @@unique([setterId, key])
}

model SetterDocRevision {
  id        String    @id @default(cuid())
  docId     String
  doc       SetterDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  body      String
  author    String?
  createdAt DateTime  @default(now())

  @@index([docId, createdAt])
}

/// One broadcast = one send (dm-crm slice 5): built as a draft, started by
/// Kevin, kept as a record. Follow-up Friday is a new one each week, made with
/// Duplicate. Nothing sends without Kevin approving each message.
model Broadcast {
  id               String   @id @default(cuid())
  workspaceId      String
  /// URL slug, unique per workspace. Migrated runs: <key>-<YYYY-MM-DD>.
  key              String
  name             String
  /// The managed tag (Tag.id) the audience is read from. Null when the
  /// audience is a fixed list (contactIds).
  audienceTagId    String?
  /// "New broadcast to these N": exactly these contacts, no tag.
  contactIds       String[]
  /// draft | drafting | in_review | scheduled | sending | sent | cancelled
  status           String   @default("draft")
  /// now | window
  startMode        String   @default("window")
  /// "YYYY-MM-DD" in timezone (window mode). Null for now mode and drafts.
  sendDate         String?
  /// BroadcastBubble[] (lib/os/broadcasts/types.ts): {type:"text", text} or
  /// {type:"link", url, resourceId?}; a link bubble with url null still needs one.
  bubbles          Json     @default("[]")
  /// per_person | variations | as_written
  personaliseMode  String   @default("per_person")
  /// The 5 variations (string[][] of text bubbles), variations mode only.
  variations       Json     @default("[]")
  /// The broadcast this one was duplicated from. Migrated runs point at the
  /// kept weekly row ("Earlier sends").
  duplicatedFromId String?
  /// Legacy: Kevin's words with {first_name}; bubbles is the source now.
  template         String   @default("")
  followupTemplate String?
  followupDelayMin Int      @default(5)
  /// "HH:MM"
  windowStart      String   @default("10:00")
  windowEnd        String   @default("15:00")
  timezone         String   @default("Europe/Luxembourg")
  setterId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  runs BroadcastRun[]

  @@unique([workspaceId, key])
  @@index([workspaceId, createdAt])
}

/// The one run of a broadcast (at most one per broadcast, kept by app code).
/// status: drafting | review | scheduled | done.
model BroadcastRun {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" in the broadcast timezone.
  runDate     String
  /// Legacy weekly link; links live on the broadcast's bubbles now.
  link        String?
  status      String    @default("drafting")
  createdAt   DateTime  @default(now())

  messages BroadcastMessage[]

  @@unique([broadcastId, runDate])
}

/// One personalised message of a run. status: drafted | approved | scheduled |
/// sent | skipped | failed | outside_window.
model BroadcastMessage {
  id              String       @id @default(cuid())
  runId           String
  run             BroadcastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  workspaceId     String
  contactId       String
  bubbles         String[]
  followupBubbles String[]
  status          String       @default("drafted")
  edited          Boolean      @default(false)
  scheduledAt     DateTime?
  sentAt          DateTime?
  error           String?
  reasoning       String?
  /// Link guard: "already_had_link" (drafted, collapsed and unapproved in Review).
  leftOutReason   String?
  /// Kevin un-collapsed a left-out draft ("include anyway").
  includedAnyway  Boolean      @default(false)
  /// Why it was skipped: sent_by_kevin | cancelled | left_the_tag | wrote_since_drafting | ...
  skipReason      String?
  /// Links in what Kevin sent himself ("Send myself"), for the link guard.
  sentLinks       String[]

  @@unique([runId, contactId])
  @@index([workspaceId, status])
}
